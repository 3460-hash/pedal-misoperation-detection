import cv2
import mediapipe as mp
import serial
import time
import csv
import math
from collections import deque

SERIAL_PORT = "COM3"
BAUD_RATE = 115200

CAMERA_INDEX = 1
FRAME_WIDTH = 640
FRAME_HEIGHT = 480
TARGET_FPS = 30

CSV_FILENAME = "pedal_training_data.csv"

HEEL_THRESHOLD = 10000    
BASELINE_SECONDS = 3.0    

MIN_DETECTION_CONFIDENCE = 0.6
MIN_TRACKING_CONFIDENCE = 0.8
MIN_VISIBILITY = 0.65

SMOOTHING_WINDOW = 7      



def distance(p1, p2):
    if p1 is None or p2 is None:
        return 0.0
    return math.sqrt((p1[0] - p2[0]) ** 2 + (p1[1] - p2[1]) ** 2)


def get_smoothed_point(buffer):
    if len(buffer) == 0:
        return None

    x_sum = sum(p[0] for p in buffer)
    y_sum = sum(p[1] for p in buffer)

    return (
        x_sum / len(buffer),
        y_sum / len(buffer)
    )


def read_latest_loadcell_value(ser, last_value):

    latest_value = last_value

    try:
        while ser.in_waiting > 0:
            line = ser.readline().decode("utf-8", errors="ignore").strip()

            try:
                latest_value = int(line)
            except ValueError:
                pass

    except Exception:
        pass

    return latest_value


def measure_baseline(ser, seconds=3.0):
    print("로드셀 baseline 측정 중, 발을 올리지 말고 기다리세요.")

    values = []
    start_time = time.time()

    while time.time() - start_time < seconds:
        try:
            if ser.in_waiting > 0:
                line = ser.readline().decode("utf-8", errors="ignore").strip()

                try:
                    value = int(line)
                    values.append(value)
                except ValueError:
                    pass

        except Exception:
            pass

        time.sleep(0.01)

    if len(values) == 0:
        print("baseline 측정 실패: 로드셀 값을 받지 못했습니다.")
        print("임시 baseline = 0 으로 설정합니다.")
        return 0

    baseline = sum(values) / len(values)
    print(f"baseline 측정 완료: {baseline:.2f}")
    return baseline



try:
    ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=0.01)
    time.sleep(2)
    print(f"Arduino 연결 완료: {SERIAL_PORT}")
except Exception as e:
    print("Arduino Serial 연결 실패")
    print(e)
    print("포트 번호를 확인하세요.")
    raise SystemExit


baseline = measure_baseline(ser, BASELINE_SECONDS)
latest_loadcell_value = int(baseline)


csv_file = open(CSV_FILENAME, mode="w", newline="", encoding="utf-8-sig")
csv_writer = csv.writer(csv_file)

csv_writer.writerow([
    "timestamp",
    "label",
    "ankle_speed",
    "toe_speed",
    "heel_contact"
])

mp_pose = mp.solutions.pose

pose = mp_pose.Pose(
    static_image_mode=False,
    model_complexity=1,
    smooth_landmarks=True,
    enable_segmentation=False,
    min_detection_confidence=MIN_DETECTION_CONFIDENCE,
    min_tracking_confidence=MIN_TRACKING_CONFIDENCE
)

cap = cv2.VideoCapture(CAMERA_INDEX)

cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_WIDTH)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
cap.set(cv2.CAP_PROP_FPS, TARGET_FPS)

if not cap.isOpened():
    print("카메라를 열 수 없습니다.")
    csv_file.close()
    ser.close()
    raise SystemExit


label = 0
saving = False
labeling_active = True

prev_time = None
prev_ankle = None
prev_toe = None

ankle_buffer = deque(maxlen=SMOOTHING_WINDOW)
toe_buffer = deque(maxlen=SMOOTHING_WINDOW)
knee_buffer = deque(maxlen=SMOOTHING_WINDOW)

ankle_speed = 0.0
toe_speed = 0.0
heel_contact = 0

print()
print("===== 조작키 =====")
print("n : 정상 label 0")
print("m : 비정상 label 1")
print("s : 저장 시작/정지")
print("x : 라벨링 종료 및 저장 정지")
print("ESC : 프로그램 종료")
print("=================")
print()


while True:
    loop_start = time.time()

    ret, frame = cap.read()

    if not ret:
        print("프레임을 읽을 수 없습니다.")
        break

    frame = cv2.resize(frame, (FRAME_WIDTH, FRAME_HEIGHT))


    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = pose.process(rgb_frame)

    current_time = time.time()

    right_knee = None
    right_ankle = None
    right_toe = None

    tracking_ok = False

    if results.pose_landmarks:
        landmarks = results.pose_landmarks.landmark

        knee_lm = landmarks[mp_pose.PoseLandmark.RIGHT_KNEE]
        ankle_lm = landmarks[mp_pose.PoseLandmark.RIGHT_ANKLE]
        toe_lm = landmarks[mp_pose.PoseLandmark.RIGHT_FOOT_INDEX]

        if (
            knee_lm.visibility >= MIN_VISIBILITY and
            ankle_lm.visibility >= MIN_VISIBILITY and
            toe_lm.visibility >= MIN_VISIBILITY
        ):
            right_knee = (int(knee_lm.x * FRAME_WIDTH), int(knee_lm.y * FRAME_HEIGHT))
            right_ankle = (int(ankle_lm.x * FRAME_WIDTH), int(ankle_lm.y * FRAME_HEIGHT))
            right_toe = (int(toe_lm.x * FRAME_WIDTH), int(toe_lm.y * FRAME_HEIGHT))

            knee_buffer.append(right_knee)
            ankle_buffer.append(right_ankle)
            toe_buffer.append(right_toe)

            smooth_knee = get_smoothed_point(knee_buffer)
            smooth_ankle = get_smoothed_point(ankle_buffer)
            smooth_toe = get_smoothed_point(toe_buffer)

            if smooth_knee is not None and smooth_ankle is not None and smooth_toe is not None:
                tracking_ok = True

                knee_draw = (int(smooth_knee[0]), int(smooth_knee[1]))
                ankle_draw = (int(smooth_ankle[0]), int(smooth_ankle[1]))
                toe_draw = (int(smooth_toe[0]), int(smooth_toe[1]))

                # 점 찍기
                cv2.circle(frame, knee_draw, 7, (0, 255, 255), -1)
                cv2.circle(frame, ankle_draw, 7, (0, 255, 0), -1)
                cv2.circle(frame, toe_draw, 7, (255, 0, 0), -1)

                # 선 연결
                cv2.line(frame, knee_draw, ankle_draw, (255, 255, 255), 2)
                cv2.line(frame, ankle_draw, toe_draw, (255, 255, 255), 2)

                # 속도 계산: pixel/sec
                if prev_time is not None:
                    dt = current_time - prev_time

                    if dt > 0:
                        ankle_speed = distance(smooth_ankle, prev_ankle) / dt if prev_ankle is not None else 0.0
                        toe_speed = distance(smooth_toe, prev_toe) / dt if prev_toe is not None else 0.0

                prev_ankle = smooth_ankle
                prev_toe = smooth_toe
                prev_time = current_time

    if not tracking_ok:
        ankle_speed = 0.0
        toe_speed = 0.0

    latest_loadcell_value = read_latest_loadcell_value(ser, latest_loadcell_value)

    loadcell_delta = abs(latest_loadcell_value - baseline)

    if loadcell_delta >= HEEL_THRESHOLD:
        heel_contact = 1
    else:
        heel_contact = 0

    if saving and labeling_active:
        csv_writer.writerow([
            current_time,
            label,
            round(ankle_speed, 4),
            round(toe_speed, 4),
            heel_contact
        ])

    y = 30
    line_gap = 28

    cv2.putText(frame, f"Label: {label} ({'normal' if label == 0 else 'misoperation'})",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
    y += line_gap

    cv2.putText(frame, f"Saving: {'ON' if saving else 'OFF'}",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.7,
                (0, 255, 0) if saving else (0, 0, 255), 2)
    y += line_gap

    cv2.putText(frame, f"Ankle speed: {ankle_speed:.2f} px/s",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    y += line_gap

    cv2.putText(frame, f"Toe speed: {toe_speed:.2f} px/s",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    y += line_gap

    cv2.putText(frame, f"Heel contact: {heel_contact}",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    y += line_gap

    cv2.putText(frame, f"Loadcell raw: {latest_loadcell_value}",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (200, 200, 200), 2)
    y += line_gap

    cv2.putText(frame, f"Delta: {loadcell_delta:.0f}",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (200, 200, 200), 2)
    y += line_gap

    cv2.putText(frame, f"Tracking: {'OK' if tracking_ok else 'LOST'}",
                (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.7,
                (0, 255, 0) if tracking_ok else (0, 0, 255), 2)

    cv2.imshow("Pedal Misoperation Data Collector", frame)

    key = cv2.waitKey(1) & 0xFF

    if key == ord('n'):
        label = 0
        print("Label changed: 0 normal")

    elif key == ord('m'):
        label = 1
        print("Label changed: 1 misoperation")

    elif key == ord('s'):
        if labeling_active:
            saving = not saving
            print(f"Saving: {'ON' if saving else 'OFF'}")

    elif key == ord('x'):
        labeling_active = False
        saving = False
        print("라벨링 종료. 저장 정지.")

    elif key == 27:
        print("프로그램 종료")
        break

    elapsed = time.time() - loop_start
    wait_time = max(0, (1.0 / TARGET_FPS) - elapsed)
    time.sleep(wait_time)


cap.release()
cv2.destroyAllWindows()
csv_file.close()
ser.close()
pose.close()

print(f"CSV 저장 완료: {CSV_FILENAME}")
