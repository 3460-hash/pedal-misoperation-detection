from google.colab import files
uploaded = files.upload()

import os
import numpy as np
import pandas as pd
import tensorflow as tf
import joblib

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import classification_report, confusion_matrix
from sklearn.utils.class_weight import compute_class_weight

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Input, LSTM, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint



CSV_FILE = "pedal_training_data_cleaneded.csv"

FEATURE_COLUMNS = [
    "ankle_speed",
    "toe_speed",
    "heel_contact"
]

LABEL_COLUMN = "label"

WINDOW_SIZE = 30

STEP_SIZE = 1

MODEL_SAVE_PATH = "pedal_lstm_model.keras"
SCALER_SAVE_PATH = "pedal_scaler.pkl"

RANDOM_STATE = 42



if not os.path.exists(CSV_FILE):
    csv_files = [name for name in uploaded.keys() if name.endswith(".csv")]

    if len(csv_files) == 0:
        raise FileNotFoundError("업로드된 CSV 파일이 없습니다.")

    CSV_FILE = csv_files[0]
    print("CSV_FILE 자동 설정:", CSV_FILE)


df = pd.read_csv(CSV_FILE)

print("원본 데이터 크기:", df.shape)
print(df.head())
print()

required_columns = FEATURE_COLUMNS + [LABEL_COLUMN]

for col in required_columns:
    if col not in df.columns:
        raise ValueError(f"필수 컬럼이 없습니다: {col}")

df = df[required_columns].copy()
df = df.dropna().reset_index(drop=True)

df[LABEL_COLUMN] = df[LABEL_COLUMN].astype(int)
df["heel_contact"] = df["heel_contact"].astype(int)

# 혹시 모를 이상한 label 제거
df = df[df[LABEL_COLUMN].isin([0, 1])].copy()
df = df[df["heel_contact"].isin([0, 1])].copy()
df = df.reset_index(drop=True)

print("정리 후 데이터 크기:", df.shape)
print("라벨 분포:")
print(df[LABEL_COLUMN].value_counts())
print()


scaler = StandardScaler()
df[FEATURE_COLUMNS] = scaler.fit_transform(df[FEATURE_COLUMNS])

print("스케일링 완료")
print(df.head())
print()


def make_sequences(dataframe, feature_cols, label_col, window_size, step_size):
    X = []
    y = []

    features = dataframe[feature_cols].values
    labels = dataframe[label_col].values

    for start in range(0, len(dataframe) - window_size + 1, step_size):
        end = start + window_size

        window_features = features[start:end]
        window_labels = labels[start:end]

        count_0 = np.sum(window_labels == 0)
        count_1 = np.sum(window_labels == 1)

        if count_1 > count_0:
            window_label = 1
        else:
            window_label = 0

        X.append(window_features)
        y.append(window_label)

    return np.array(X), np.array(y)


X, y = make_sequences(
    df,
    FEATURE_COLUMNS,
    LABEL_COLUMN,
    WINDOW_SIZE,
    STEP_SIZE
)

print("X shape:", X.shape)
print("y shape:", y.shape)
print("시퀀스 라벨 분포:")
print(pd.Series(y).value_counts())
print()

if len(np.unique(y)) < 2:
    raise ValueError("정상/오작동 두 라벨이 모두 있어야 학습할 수 있습니다.")


X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.2,
    random_state=RANDOM_STATE,
    stratify=y
)

print("X_train:", X_train.shape)
print("X_test:", X_test.shape)
print()


classes = np.array([0, 1])

class_weights_array = compute_class_weight(
    class_weight="balanced",
    classes=classes,
    y=y_train
)

class_weight = {
    0: class_weights_array[0],
    1: class_weights_array[1]
}

print("class_weight:", class_weight)
print()


model = Sequential([
    Input(shape=(WINDOW_SIZE, len(FEATURE_COLUMNS))),

    LSTM(64, return_sequences=True),
    Dropout(0.3),

    LSTM(32),
    Dropout(0.3),

    Dense(32, activation="relu"),
    Dropout(0.2),

    Dense(1, activation="sigmoid")
])

model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),
    loss="binary_crossentropy",
    metrics=["accuracy"]
)

model.summary()



early_stopping = EarlyStopping(
    monitor="val_loss",
    patience=10,
    restore_best_weights=True
)

checkpoint = ModelCheckpoint(
    MODEL_SAVE_PATH,
    monitor="val_loss",
    save_best_only=True
)

history = model.fit(
    X_train,
    y_train,
    validation_split=0.2,
    epochs=100,
    batch_size=32,
    callbacks=[early_stopping, checkpoint],
    class_weight=class_weight,
    verbose=1
)



loss, acc = model.evaluate(X_test, y_test, verbose=0)

print()
print("===== Test Result =====")
print("Test loss:", loss)
print("Test accuracy:", acc)

y_pred_prob = model.predict(X_test)
y_pred = (y_pred_prob >= 0.5).astype(int).reshape(-1)

print()
print("===== Confusion Matrix =====")
print(confusion_matrix(y_test, y_pred))

print()
print("===== Classification Report =====")
print(classification_report(
    y_test,
    y_pred,
    target_names=["normal", "misoperation"]
))



model.save(MODEL_SAVE_PATH)
joblib.dump(scaler, SCALER_SAVE_PATH)

print()
print("저장 완료:")
print(MODEL_SAVE_PATH)
print(SCALER_SAVE_PATH)


files.download(MODEL_SAVE_PATH)
files.download(SCALER_SAVE_PATH)
